# Local environment and OS files
.venv/
__pycache__/
.DS_Store

# Source datasets (downloaded by each user; see README) -- data/glossary.md is tracked
data/*
!data/glossary.md
!data/README.md

# Pipeline outputs are regenerated locally; the public, ID-only subset lives in release/
outputs/*
!outputs/group_labels.tsv
fpr_annotation/outputs/
outputs_*_backup/

# Personal working files, archived code, and paper sources
scratch/
deprecated/
paper/
hirave_oet_proposal.pdf

# Tabular data is private by default: most of it contains post text.
# Exceptions below are files verified to contain none.
*.tsv
*.csv
*.parquet
!release/**
!annotations/annotator1_labels.tsv
!annotations/annotator2_labels.tsv
!annotations/annotator1_glossary.tsv
!annotations/annotator2_glossary.tsv
!annotations/merged_labels_resolved.tsv
!annotations/merged_glossary_resolved.tsv
!outputs/group_labels.tsv

# Superseded export of one annotator's worksheets; not used by any code
annotation_results/
